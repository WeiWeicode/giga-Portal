# 複製為 .env(不入版控);本機開發連 giganexus_gw_test(與測試區共用,讀寫的是 src_* 複本與 schema portal)
GW_ENV=dev
SERVICE_CODE=portal-api
PORT=51271
GW_BASE_URL=https://giganexus-test.gigasolar.com.tw
# 本機直連不經 BFF 時可略過內部 Token(只在 dev);DEV_EMP 指定模擬的工號
# DEV_SKIP_TOKEN=1
# DEV_EMP=S112009
PORTAL_DB_HOST=10.10.130.220
PORTAL_DB_NAME=giganexus_gw_test
PORTAL_DB_USER=portal_app
PORTAL_DB_PASSWORD=
# 舊庫來源:copy(src_* 複本,dev / test 預設)/ legacy(220 原庫,prod 預設);個別覆寫 PORTAL_SRC_<KEY>=資料庫.schema
# PORTAL_SRC_MODE=copy
# 選用:通勤調查地址轉經緯度(Google Geocoding);未設定時通勤調查不能送出
# GOOGLE_MAPS_API_KEY=
# migration(npm run db:migrate,套用到 PORTAL_DB_NAME 的 schema portal;帳號 portal_migrate,只放開發者電腦)
PORTAL_MIGRATE_USER=portal_migrate
PORTAL_MIGRATE_PASSWORD=
# 整合測試(npm run test:int)專用庫:會清空 schema portal,不可指向 giganexus_gw_test
PORTAL_TEST_DB_NAME=giganexus_gw_poc_test
